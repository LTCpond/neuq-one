<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:layout_weight="1">
    <ImageView android:id="@+id/widget_period_border" android:layout_width="match_parent" android:layout_height="1dp" android:src="@drawable/widget_grid_stroke" android:importantForAccessibility="no" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center">
        <TextView android:id="@+id/widget_period_number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_primary" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"  />
        <TextView android:id="@+id/widget_period_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="9sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"  />
    </LinearLayout>
</LinearLayout>
