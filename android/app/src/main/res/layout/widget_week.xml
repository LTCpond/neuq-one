<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_surface" android:clipToOutline="true" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_week_reset" android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:paddingStart="4dp">
            <TextView android:id="@+id/widget_week_eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="10sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:text="NEUQ · TIMETABLE" />
            <TextView android:id="@+id/widget_week_title" android:text="@string/widget_week_label" android:layout_width="match_parent" android:layout_height="28dp" android:textColor="@color/widget_primary" android:textSize="24sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp"  />
            <TextView android:id="@+id/widget_week_range" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"  />
        </LinearLayout>
        <ImageView android:id="@+id/widget_previous" android:layout_width="36dp" android:layout_height="44dp" android:src="@drawable/widget_chevron_left" android:importantForAccessibility="yes" android:contentDescription="上一教学周" android:scaleType="centerInside" />
        <ImageView android:id="@+id/widget_next" android:layout_width="36dp" android:layout_height="44dp" android:src="@drawable/widget_chevron_right" android:importantForAccessibility="yes" android:contentDescription="下一教学周" android:scaleType="centerInside" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_days" android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal"  />
    <LinearLayout android:id="@+id/widget_week_grid" android:layout_width="match_parent" android:layout_height="0dp" android:orientation="horizontal" android:layout_weight="1" />
    <LinearLayout android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/widget_empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_primary" android:textSize="15sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"  />
        <TextView android:id="@+id/widget_empty_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
