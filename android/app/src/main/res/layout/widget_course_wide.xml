<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/widget_row_height" android:layout_width="1dp" android:layout_height="wrap_content" android:textColor="@color/widget_primary" android:textSize="1sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="invisible" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_row_click" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_course_stripe" android:layout_width="3dp" android:layout_height="match_parent" android:src="@drawable/widget_pill" android:importantForAccessibility="no" android:layout_marginTop="4dp" android:layout_marginBottom="4dp" android:scaleType="fitXY" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="8dp">
            <TextView android:id="@+id/widget_course_name" android:layout_width="match_parent" android:layout_height="17dp" android:textColor="@color/widget_primary" android:textSize="14sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp"  />
            <TextView android:id="@+id/widget_course_room" android:layout_width="match_parent" android:layout_height="14dp" android:textColor="@color/widget_muted" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp"  />
        </LinearLayout>
        <TextView android:id="@+id/widget_course_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="5dp" />
    </LinearLayout>
</FrameLayout>
