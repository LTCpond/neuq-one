<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_course_position" android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:id="@+id/widget_week_course_click" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/widget_course_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_course_surface" android:importantForAccessibility="no" android:scaleType="fitXY" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="1dp" android:paddingEnd="1dp" android:paddingTop="2dp">
            <TextView android:id="@+id/widget_course_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_primary" android:textSize="10sp" android:includeFontPadding="false" android:fallbackLineSpacing="false" android:breakStrategy="simple" android:hyphenationFrequency="none" android:maxLines="3" android:ellipsize="end" android:textStyle="bold"  />
            <TextView android:id="@+id/widget_course_room" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_primary" android:textSize="9sp" android:includeFontPadding="false" android:fallbackLineSpacing="false" android:breakStrategy="simple" android:hyphenationFrequency="none" android:maxLines="3" android:ellipsize="end"  />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
